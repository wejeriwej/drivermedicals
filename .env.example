# Required for appointment storage. Use a single-line JSON Firebase service account.
FIREBASE_SERVICE_ACCOUNT=

# Required for booking emails via Gmail SMTP
GMAIL_USER=admin.prodrivermedicals@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
BOOKING_ADMIN_EMAIL=admin.prodrivermedicals@gmail.com

# Automatic business-calendar sync. Enable the Google Calendar API in the
# Firebase project's Google Cloud console, then share this calendar with the
# client_email inside FIREBASE_SERVICE_ACCOUNT and grant "Make changes to events".
# For a primary Google calendar, its ID is normally the Gmail address.
GOOGLE_CALENDAR_ID=admin.prodrivermedicals@gmail.com

# Optional: use a different service account for Calendar. If omitted, the
# FIREBASE_SERVICE_ACCOUNT credentials above are reused.
GOOGLE_CALENDAR_SERVICE_ACCOUNT=

# Leave false for pay-at-clinic bookings. Set true to restore the preserved
# Stripe deposit/full-payment checkout flow (and update the matching frontend
# BOOKING_PREPAYMENT_REQUIRED constant in public/added.js).
BOOKING_PREPAYMENT_REQUIRED=false
